apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: argocd-route
  namespace: argocd
spec:
  parentRefs:
    - name: ${workspace}-gateway
      namespace: envoy-gateway-system
      sectionName: https-wildcard
  hostnames:
    - argocd.${creator}-${workspace}.${domain}
  rules:
    - backendRefs:
        - name: argocd-server
          port: 80
