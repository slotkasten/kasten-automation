apiVersion: config.kio.kasten.io/v1alpha1
kind: Policy
metadata:
  name: k10-disaster-recovery-policy
  namespace: kasten-io
spec:
  actions:
  - action: backup
    backupParameters:
      filters: {}
      profile:
        name: ${creator}-${workspace}-azure-location
        namespace: kasten-io
  - action: export
    exportParameters:
      exportData:
        enabled: true
      profile:
        name: ${creator}-${workspace}-azure-location
        namespace: kasten-io
  frequency: '@daily'
  kdrSnapshotConfiguration:
    takeLocalCatalogSnapshot: true
    exportCatalogSnapshot: true
  retention:
    daily: 1
    monthly: 1
    weekly: 1
    yearly: 1
  selector:
    matchExpressions:
    - key: k10.kasten.io/appNamespace
      operator: In
      values:
      - kasten-io
