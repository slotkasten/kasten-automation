apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: ${workspace}-gateway
  namespace: envoy-gateway-system
  annotations:
    cert-manager.io/cluster-issuer: ${letsencrypt_staging ? "letsencrypt-staging" : "letsencrypt-prod"}
spec:
  gatewayClassName: eg
  listeners:
    - name: https-wildcard
      protocol: HTTPS
      port: 443
      hostname: "*.${workspace}.${domain}"
      allowedRoutes:
        namespaces:
          from: All
      tls:
        mode: Terminate
        certificateRefs:
          - name: wildcard-tls
            kind: Secret
    - name: http
      protocol: HTTP
      port: 80
      hostname: "*.${workspace}.${domain}"
      allowedRoutes:
        namespaces:
          from: Same
