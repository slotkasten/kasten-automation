apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: pacman-route
  namespace: pacman
spec:
  parentRefs:
    - name: ${workspace}-gateway
      namespace: envoy-gateway-system
      sectionName: https-wildcard
  hostnames:
    - pacman.${creator}-${workspace}.${domain}
  rules:
    - backendRefs:
        - name: pacman
          port: 80
