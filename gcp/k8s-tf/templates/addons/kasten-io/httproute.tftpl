apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: kasten-route
  namespace: kasten-io
spec:
  parentRefs:
    - name: ${workspace}-gateway
      namespace: envoy-gateway-system
      sectionName: https-wildcard
  hostnames:
    - kasten.${creator}-${workspace}.${domain}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /k10
      backendRefs:
        - name: gateway
          port: 80
